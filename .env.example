# Required
DATABASE_URL=postgres://overhear:overhear@localhost:5432/overhear
RETELL_API_KEY=key_xxx
ANTHROPIC_API_KEY=sk-ant-xxx
APP_URL=http://localhost:3000

# Optional
# Get a key at console.typesafe.ai. When set together with JUDGE_PROVIDER=jev,
# the judge runs on Jev (TypeSafe AI). Otherwise it falls back to Claude.
JEV_API_KEY=
JUDGE_PROVIDER=jev
# Set after provisioning the Retell agent.
RETELL_AGENT_ID=
# Shared password for the deployed dashboard, read directly by src/proxy.ts.
# Leave unset for open local dev, any username is accepted with this password.
DASHBOARD_PASSWORD=

# Local mode: the product on your own machine, which takes a pasted Retell key.
# Set by `npm run local`, which also binds 127.0.0.1 so nothing on your network
# can reach it. Leave unset on a hosted copy: there the key routes answer 404.
# Do not set it with plain `npm run dev` or `npm start`, which bind every interface.
OVERHEAR_LOCAL=
# Where local mode keeps the pasted key (config.json, mode 0600, in a 0700
# directory). Defaults to ~/.overhear. Must be an absolute path to a directory
# used only by Overhear, because its permissions are tightened to 0700.
OVERHEAR_HOME=
# The Retell agent id of the demo agent (the Northwind clinic). Only a call from
# this agent is checked under the demo's preset policy. Leave unset for your own
# agents: every call that carries an agent id is then checked under a policy
# inferred from its tools. The id is not secret, but it is not kept in the code.
OVERHEAR_DEMO_AGENT_ID=
# Dev only: serve extra demo report states (an unverified result, an unreadable
# report, a slow load) at /reports/call_demo_*. Ignored when NODE_ENV is production.
OVERHEAR_DEMO_STATES=
