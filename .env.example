# Required
DATABASE_URL=postgres://overhear:overhear@localhost:5432/overhear
RETELL_API_KEY=key_xxx
ANTHROPIC_API_KEY=sk-ant-xxx
APP_URL=http://localhost:3000

# Optional
# Get a key at console.typesafe.ai. When set together with JUDGE_PROVIDER=jev,
# the judge runs on Jev (TypeSafe AI). Otherwise it falls back to Claude.
JEV_API_KEY=
JUDGE_PROVIDER=jev
# Set after provisioning the Retell agent.
RETELL_AGENT_ID=
